{
  "agent_name": "Qwen-Hands-Eyes (SkyGround OS)",
  "mode": "dual_brain",
  "workspace_root": ".",
  "primary_brain": {
    "provider": "ollama",
    "base_url": "http://localhost:11434",
    "model": "qwen2.5:7b-instruct-q4_K_M",
    "temperature": 0.7,
    "max_tokens": 4096,
    "top_p": 0.9,
    "num_ctx": 8192,
    "api_key": "",
    "timeout_sec": 120
  },
  "reasoning_brain": {
    "enabled": true,
    "provider": "ollama",
    "base_url": "http://localhost:11434",
    "model": "deepseek-r1:7b",
    "temperature": 0.6,
    "max_tokens": 8192,
    "api_key": "",
    "timeout_sec": 180,
    "auto_translate_persian": true,
    "preserve_reasoning_tags": true,
    "trigger_mode": "auto",
    "routing_keywords": [
      "code",
      "algorithm",
      "math",
      "reasoning",
      "logic",
      "debug",
      "script",
      "function",
      "python",
      "fix",
      "کد",
      "برنامه‌نویسی",
      "الگوریتم",
      "ریاضی",
      "استدلال",
      "منطق",
      "دیباگ",
      "تحلیل",
      "محاسبه",
      "تابع",
      "پایتون",
      "اسکریپت"
    ]
  },
  "eyes": {
    "enabled": true,
    "vlm_provider": "ollama",
    "vlm_base_url": "http://localhost:11434",
    "vlm_model": "qwen2-vl:7b",
    "vlm_api_key": "",
    "screen_capture_interval": 1.0,
    "max_image_dimension": 1280,
    "ocr_engine": "vlm",
    "auto_observe_desktop": false,
    "save_snapshots_dir": ".qwen_hands_eyes/snapshots"
  },
  "hands": {
    "enabled": true,
    "safe_mode": true,
    "require_approval": true,
    "auto_approve_low_risk": false,
    "mouse_speed": 0.2,
    "failsafe_corner": true,
    "command_timeout_sec": 30,
    "max_file_read_chars": 20000,
    "create_backups": true,
    "backup_dir": ".qwen_hands_eyes/backups",
    "allowed_cwd_root": ".",
    "blocked_commands": [
      "rm -rf /",
      "rmdir /s /q c:\\",
      "mkfs",
      "dd if=",
      ":(){ :|:& };:",
      "format c:",
      "del /f /s /q c:\\windows",
      "shutdown",
      "reboot"
    ]
  },
  "feet": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 8765,
    "static_ip": "",
    "api_token": "skyground_secret_token_default",
    "enable_cors": true,
    "enable_websocket": true,
    "mobile_friendly_payloads": true,
    "push_webhook_url": ""
  },
  "memory": {
    "sqlite_path": ".qwen_hands_eyes/memory.sqlite",
    "dsa_fade_not_forget": true,
    "dsa_lambda": 0.15,
    "dsa_gamma": 0.4,
    "dsa_min": 0.15,
    "max_recent_memories": 10,
    "max_search_results": 6
  }
}
